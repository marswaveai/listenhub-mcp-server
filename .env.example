# ListenHub MCP Server - Environment Variables

# Required: ListenHub API Key
LISTENHUB_API_KEY=your_api_key_here

# Optional: Transport mode (stdio, http, sse)
# TRANSPORT=stdio

# Required in http/sse mode: shared secret clients must send as
# "Authorization: Bearer <token>". Generate one with e.g. `openssl rand -hex 32`.
# MCP_AUTH_TOKEN=

# Optional: HTTP server port (http/sse modes)
# PORT=3000

# Optional: HTTP bind address (http/sse modes). Defaults to 127.0.0.1;
# use 0.0.0.0 only when the port is meant to be reachable from other hosts.
# HOST=127.0.0.1
